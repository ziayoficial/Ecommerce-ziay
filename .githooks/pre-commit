#!/bin/bash
set -e
# AUTOFIX-D-1 — `set -o pipefail` so the exit status of a piped command is
# the rightmost NON-ZERO exit of any segment. Without it, `cmd | head` is
# always exit 0 (because `head` succeeds), masking a failing `tsc`/`eslint`.
# The original hook silently let broken commits through — `tsc --noEmit
# --incremental | head -20` always reported success.
set -o pipefail

# Run quick checks before allowing a commit
echo "🔍 Running pre-commit checks..."

# Type check (fast — uses cache). Capture status — `set -o pipefail` makes
# the pipeline fail if `tsc` exits non-zero, regardless of `head`.
# Bun-only installs don't create node_modules/.bin/tsc shims, so plain
# `npx tsc` resolves to the registry decoy package "tsc" and fails with
# "This is not the tsc command you are looking for". Prefer bunx (the
# stack's recommended runtime) and fall back to npx for npm installs.
if command -v bunx >/dev/null 2>&1; then
  bunx tsc --noEmit --incremental 2>&1 | head -20
else
  npx tsc --noEmit --incremental 2>&1 | head -20
fi
if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed"
  exit 1
fi

# Lint (only changed files for speed). Non-blocking by design: the CI lint
# job is the real gate; here we only surface issues for the committer.
# `|| true` on the pipeline: with `set -e` + pipefail, a `grep` with no
# matches (e.g. docs-only commits) exits 1 and would abort the whole hook.
# `set +e` around the eslint run so its non-zero exit can't kill the hook
# either, despite the "non-blocking" contract below.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | head -20 || true)
if [ -n "$STAGED_FILES" ]; then
  set +e
  bunx eslint $STAGED_FILES --rule '{"no-unused-vars": "error"}' 2>&1 | head -20
  LINT_STATUS=${PIPESTATUS[0]}
  set -e
  if [ "$LINT_STATUS" -ne 0 ]; then
    echo "⚠️  Lint issues in staged files (non-blocking — CI lint job is the gate)"
  fi
fi

echo "✅ Pre-commit checks passed"
